# broadworks-mcp — local environment file
#
# Copy this file to ".env" and fill in the values you need:
#
#   cp .env.example .env
#
# ./run.sh loads ".env" automatically on every command. Any variable already set
# in your shell (or passed inline, e.g. `ALPACA_LIVE=false ./run.sh run`)
# takes precedence. The real ".env" is git-ignored and must never be committed.
#
# This file is NOT read by the MCPCICD pipeline or by ECS.
#   - Google / Alpaca secrets in AWS: MCPCICD `./run.sh push-secrets-dev|prod`
#   - STORAGE_BACKEND, table names, KMS_KEY_ID, APPLICATION_ID, PUBLIC_HOSTNAME:
#     set by BroadWorksMcpStack as ECS task environment
#
# Supported syntax: KEY=VALUE, blank lines, "#" comments, an optional leading
# "export ", and values optionally wrapped in single or double quotes.

# ---------------------------------------------------------------------------
# Local OAuth / BroadWorks
# ---------------------------------------------------------------------------
# Required to exercise Google login and the OAuth flow on the laptop.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alpaca toolkit license for live BroadWorks from the laptop (secret).
# Leave empty to use a provisioned license file / license manager instead.
ALPACA_LICENSE_KEY=

# ---------------------------------------------------------------------------
# Local runtime
# ---------------------------------------------------------------------------
# Local `./run.sh run` always uses in-memory stores. Keep this as IN_MEMORY so a
# plain `java -jar` with this file sourced does not try to reach AWS tables.
STORAGE_BACKEND=IN_MEMORY

# Leave unset/empty so the base URL is http://localhost:8080.
# PUBLIC_HOSTNAME=

# Allow connecting to a BroadWorks host on a private LAN (disables the SSRF guard).
# ALLOW_PRIVATE_NETWORK_TARGETS=true

# Extra OAuth redirect-URI prefixes (loopback HTTP is always allowed).
# OAUTH_REDIRECT_ALLOWLIST=

# ---------------------------------------------------------------------------
# run.sh helpers (optional)
# ---------------------------------------------------------------------------
# JAVA_HOME=/path/to/jdk21
# IMAGE_NAME=broadworks-mcp:latest
