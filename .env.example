# broadworks-mcp — example environment file
#
# Copy this file to ".env" and fill in the values you need:
#
#   cp .env.example .env
#
# run.sh loads ".env" automatically on every command. Any variable already set
# in your shell (or passed inline, e.g. `PUBLIC_BASE_URL=... ./run.sh run`)
# takes precedence over the value here. The real ".env" is git-ignored and must
# never be committed — it may contain secrets.
#
# Supported syntax: KEY=VALUE, blank lines, "#" comments, an optional leading
# "export ", and values optionally wrapped in single or double quotes.

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
# Public DNS hostname (no scheme or path), e.g. mcp.example.com. The base URL is
# built as https://<hostname> and used for discovery docs and the
# resource_metadata challenge. It also drives the ACM certificate created by the
# CDK infra. Leave empty for local dev (base URL defaults to
# http://localhost:8080).
PUBLIC_HOSTNAME=

# Upstream OIDC issuer.
OIDC_ISSUER_URI=https://accounts.google.com

# Google OAuth client credentials (secrets — keep them out of git).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# DYNAMODB (durable) or IN_MEMORY (local/tests). Use IN_MEMORY for local dev.
STORAGE_BACKEND=IN_MEMORY

# DynamoDB table names (only used when STORAGE_BACKEND=DYNAMODB).
SESSION_TABLE=broadworks-mcp-sessions
USER_CONFIG_TABLE=broadworks-mcp-user-config

# Customer-managed KMS key id/ARN for secret encryption (required for DYNAMODB).
KMS_KEY_ID=

# AWS region for DynamoDB/KMS (defaults to the SDK's resolved region).
AWS_REGION=us-east-2

# Partition key for the per-user resource table.
APPLICATION_ID=broadworks-mcp

# ---------------------------------------------------------------------------
# OAuth / tokens
# ---------------------------------------------------------------------------
# Comma/space list of allowed HTTPS redirect-URI prefixes
# (loopback + custom schemes are always allowed).
OAUTH_REDIRECT_ALLOWLIST=

# Opaque access-token lifetime (capped by IdP ID-token expiry).
ACCESS_TOKEN_TTL=PT1H

# Refresh-token lifetime.
REFRESH_TOKEN_TTL=P30D

# One-time authorization-code lifetime.
AUTH_CODE_TTL=PT5M

# Pending-authorization state lifetime.
PENDING_AUTH_TTL=PT15M

# Registered (DCR) client lifetime.
REGISTERED_CLIENT_TTL=P90D

# ---------------------------------------------------------------------------
# BroadWorks / Alpaca
# ---------------------------------------------------------------------------
# Idle lifetime of a cached BroadWorks connection.
ALPACA_CONNECTION_CACHE_TTL=PT30M

# ---------------------------------------------------------------------------
# run.sh helpers (optional)
# ---------------------------------------------------------------------------
# Specific JDK 21 to use for Maven/java without changing your ambient env.
# JAVA_HOME=/path/to/jdk21

# Docker image tag used by `./run.sh docker-build`.
# IMAGE_NAME=broadworks-mcp:latest

# ACM certificate ARN for the HTTPS ALB listener (deploy/synth).
# CERTIFICATE_ARN=arn:aws:acm:<region>:<acct>:certificate/<id>

HOSTED_ZONE_NAME=ecg.co
