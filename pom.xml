<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.broadworks</groupId>
    <artifactId>broadworks-mcp</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>broadworks-mcp</name>
    <description>MCP server exposing BroadWorks operations via the Alpaca toolkit</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Managed dependency versions -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <aws-sdk.version>2.51.4</aws-sdk.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <wiremock.version>3.13.2</wiremock.version>

        <!-- Alpaca toolkit (installed from lib/ via scripts/install-alpaca.sh) -->
        <alpaca.version>12.2.0-RELEASE</alpaca.version>

        <!-- ECG licensing runtime companion (installed from lib/ via scripts/install-alpaca.sh) -->
        <ecg-licensing.version>6.2.0-RELEASE</ecg-licensing.version>

        <!--
            Override the Lombok version managed by the Spring Boot parent (1.18.36).
            1.18.36 predates and does not support recent JDKs (24/25/26); when the
            build JVM is newer than what Lombok understands, its annotation processor
            is silently skipped, so @RequiredArgsConstructor / @Slf4j etc. are never
            expanded and compilation fails. 1.18.46 supports current JDKs.
        -->
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ===== Spring AI MCP server (Streamable HTTP/SSE on :8080 + stdio) ===== -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- ===== OAuth 2.1 Authorization Server + Resource Server + upstream login ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            Use the Spring Boot starter (not the raw spring-security-oauth2-authorization-server)
            so the authorization-server autoconfiguration is present. In Spring Boot 4 this
            autoconfiguration (which supplies the JwtDecoder / JWKSource required by the OIDC-enabled
            authorization server) was moved out of spring-boot-autoconfigure into its own module,
            pulled in transitively by this starter.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-authorization-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- ===== Web / validation / observability ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            Spring Framework 7 (Spring Boot 4) removed the bundled spring-jcl bridge, so the
            commons-logging API (org.apache.commons.logging.*) used by Spring and Spring Security
            (e.g. NimbusJwtDecoder) is no longer on the classpath. Provide it via the SLF4J bridge
            so JCL logging is routed through the existing Logback setup. Version managed by the BOM.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jcl-over-slf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== AWS SDK v2: durable storage (DynamoDB) + secret encryption (KMS) ===== -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>kms</artifactId>
        </dependency>

        <!-- ===== Alpaca toolkit (sole BroadWorks interface) ===== -->
        <dependency>
            <groupId>co.ecg</groupId>
            <artifactId>alpaca-library</artifactId>
            <version>${alpaca.version}</version>
        </dependency>
        <dependency>
            <groupId>co.ecg</groupId>
            <artifactId>alpaca-core</artifactId>
            <version>${alpaca.version}</version>
        </dependency>
        <dependency>
            <groupId>co.ecg</groupId>
            <artifactId>alpaca-model</artifactId>
            <version>${alpaca.version}</version>
        </dependency>
        <dependency>
            <groupId>co.ecg</groupId>
            <artifactId>alpaca-commons</artifactId>
            <version>${alpaca.version}</version>
        </dependency>
        <!--
            ECG licensing runtime: verifies the Alpaca toolkit license. Required on the classpath
            for live BroadWorks connectivity. The license itself can be supplied at runtime as a
            string via ALPACA_LICENSE_KEY (see AlpacaProperties); the jar bundles its own GPG public
            key ring (pubring.gpg) so no extra keyring provisioning is needed.
        -->
        <dependency>
            <groupId>co.ecg</groupId>
            <artifactId>ecg-licensing</artifactId>
            <version>${ecg-licensing.version}</version>
        </dependency>
        <!--
            ecg-licensing runtime companions. ecg-licensing is installed from lib/ with a MINIMAL
            generated POM (no transitive dependencies), so the plain libraries it needs at runtime are
            declared here and resolved normally from Maven Central:
              - license3j decodes/verifies the PGP-signed license string (pulls in BouncyCastle);
              - java-semver parses the license version.
            (slf4j-api is already on the classpath via the Spring Boot starters.)
        -->
        <dependency>
            <groupId>com.verhas</groupId>
            <artifactId>license3j</artifactId>
            <version>1.0.7</version>
        </dependency>
        <dependency>
            <groupId>com.github.zafarkhaja</groupId>
            <artifactId>java-semver</artifactId>
            <version>0.9.0</version>
        </dependency>

        <!-- ===== Lombok (boilerplate reduction) ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== Test ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Boot 4 modularized MockMvc test support out of spring-boot-starter-test.
            @AutoConfigureMockMvc / MockMvc auto-configuration now live in this module.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            The Alpaca generated request classes reference the legacy javax.validation API in their
            method signatures. Mockito/Byte Buddy must resolve those types to mock the (final)
            classes, so the javax.validation API must be present on the test classpath. Jakarta
            (jakarta.validation) is a different namespace and does not satisfy these references.
        -->
        <dependency>
            <groupId>javax.validation</groupId>
            <artifactId>validation-api</artifactId>
            <version>2.0.1.Final</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Explicitly declare the annotation processors on the compiler's
                processor path. Since JDK 23+ (and enforced on JDK 26) javac no
                longer runs annotation processors discovered only on the class path
                by default, so Lombok would otherwise be skipped and the build would
                fail with "cannot find symbol log" / missing generated constructors.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${project.parent.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
                Mockito's inline mock maker rewrites bytecode via Byte Buddy to
                mock the (final) Alpaca generated classes. When the test JVM is a
                JDK newer than the bundled Byte Buddy officially supports (e.g.
                JDK 26), Byte Buddy refuses to instrument classes and the mocks
                fail with "Mockito cannot mock this class ... Could not modify all
                classes". Enabling Byte Buddy's experimental mode makes it treat
                such newer JDKs as the latest known version, restoring mocking.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <net.bytebuddy.experimental>true</net.bytebuddy.experimental>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Convenience profile that installs the Alpaca toolkit JARs from lib/
            into the local Maven repository during the `initialize` phase.
            Equivalent to running scripts/install-alpaca.sh once.

            IMPORTANT: run this as its OWN invocation that stops at `initialize`,
            BEFORE building. Combining it with a resolving phase in a single
            invocation (e.g. `mvn -Pinstall-alpaca clean package`) fails on a
            clean local repo, because Maven resolves the co.ecg:* compile
            dependencies before this profile's install-file executions run.

            Usage:
              mvn -Pinstall-alpaca initialize   # populate the local repo, then
              mvn -DskipTests clean package      # build against it
        -->
        <profile>
            <id>install-alpaca</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-install-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>install-alpaca-commons</id>
                                <phase>initialize</phase>
                                <goals><goal>install-file</goal></goals>
                                <configuration>
                                    <file>${project.basedir}/lib/alpaca-commons-12.2.0-RELEASE.jar</file>
                                    <groupId>co.ecg</groupId>
                                    <artifactId>alpaca-commons</artifactId>
                                    <version>${alpaca.version}</version>
                                    <packaging>jar</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-alpaca-model</id>
                                <phase>initialize</phase>
                                <goals><goal>install-file</goal></goals>
                                <configuration>
                                    <file>${project.basedir}/lib/alpaca-model-12.2.0-RELEASE.jar</file>
                                    <groupId>co.ecg</groupId>
                                    <artifactId>alpaca-model</artifactId>
                                    <version>${alpaca.version}</version>
                                    <packaging>jar</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-alpaca-core</id>
                                <phase>initialize</phase>
                                <goals><goal>install-file</goal></goals>
                                <configuration>
                                    <file>${project.basedir}/lib/alpaca-core-12.2.0-RELEASE-26.jar</file>
                                    <groupId>co.ecg</groupId>
                                    <artifactId>alpaca-core</artifactId>
                                    <version>${alpaca.version}</version>
                                    <packaging>jar</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-alpaca-library</id>
                                <phase>initialize</phase>
                                <goals><goal>install-file</goal></goals>
                                <configuration>
                                    <file>${project.basedir}/lib/alpaca-library-12.2.0-RELEASE-26.jar</file>
                                    <groupId>co.ecg</groupId>
                                    <artifactId>alpaca-library</artifactId>
                                    <version>${alpaca.version}</version>
                                    <packaging>jar</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-ecg-licensing</id>
                                <phase>initialize</phase>
                                <goals><goal>install-file</goal></goals>
                                <configuration>
                                    <file>${project.basedir}/lib/ecg-licensing-6.2.0-RELEASE.jar</file>
                                    <groupId>co.ecg</groupId>
                                    <artifactId>ecg-licensing</artifactId>
                                    <version>${ecg-licensing.version}</version>
                                    <packaging>jar</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
