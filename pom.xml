<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.broadworks</groupId>
    <artifactId>broadworks-mcp</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>broadworks-mcp</name>
    <description>MCP server exposing BroadWorks operations via the Alpaca toolkit</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Managed dependency versions -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <aws-sdk.version>2.51.4</aws-sdk.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <wiremock.version>3.13.2</wiremock.version>

        <!-- Alpaca toolkit (installed from lib/ via scripts/install-alpaca.sh) -->
        <alpaca.version>12.2.0-RELEASE</alpaca.version>

        <!-- ECG licensing runtime companion (installed from lib/ via scripts/install-alpaca.sh) -->
        <ecg-licensing.version>6.2.0-RELEASE</ecg-licensing.version>

        <!--
            Override the Lombok version managed by the Spring Boot parent (1.18.36).
            1.18.36 predates and does not support recent JDKs (24/25/26); when the
            build JVM is newer than what Lombok understands, its annotation processor
            is silently skipped, so @RequiredArgsConstructor / @Slf4j etc. are never
            expanded and compilation fails. 1.18.46 supports current JDKs.
        -->
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ===== Spring AI MCP server (Streamable HTTP/SSE on :8080 + stdio) ===== -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- ===== OAuth 2.1 Authorization Server + Resource Server + upstream login ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            Use the Spring Boot starter (not the raw spring-security-oauth2-authorization-server)
            so the authorization-server autoconfiguration is present. In Spring Boot 4 this
            autoconfiguration (which supplies the JwtDecoder / JWKSource required by the OIDC-enabled
            authorization server) was moved out of spring-boot-autoconfigure into its own module,
            pulled in transitively by this starter.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-authorization-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!--
            Spring Session core only: backs the interactive Google-login HTTP session with a custom
            DynamoDB SessionRepository (see DynamoDbHttpSessionRepository / HttpSessionConfig) so the
            login/authorization-code handshake is shared across the load-balanced ECS tasks and
            survives restarts, instead of living in a single task's in-memory Tomcat session.
        -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-core</artifactId>
        </dependency>

        <!-- ===== Web / validation / observability ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            Spring Framework 7 (Spring Boot 4) removed the bundled spring-jcl bridge, so the
            commons-logging API (org.apache.commons.logging.*) used by Spring and Spring Security
            (e.g. NimbusJwtDecoder) is no longer on the classpath. Provide it via the SLF4J bridge
            so JCL logging is routed through the existing Logback setup. Version managed by the BOM.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jcl-over-slf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== AWS SDK v2: durable storage (DynamoDB) + secret encryption (KMS) ===== -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
        </dependency>
        <!--
            DynamoDB Enhanced Client: object mapping (@DynamoDbBean / TableSchema) over the low-level
            client, used by DynamoDbHttpSessionRepository so the interactive login session is persisted
            as a mapped item bean instead of hand-built AttributeValue maps. Version managed by the BOM.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb-enhanced</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>kms</artifactId>
        </dependency>

        <!-- ===== Alpaca toolkit (sole BroadWorks interface) ===== -->
        <dependency>
            <groupId>co.ecg</groupId>
            <artifactId>alpaca-library</artifactId>
            <version>${alpaca.version}</version>
        </dependency>
        <dependency>
            <groupId>co.ecg</groupId>
            <artifactId>alpaca-core</artifactId>
            <version>${alpaca.version}</version>
        </dependency>
        <dependency>
            <groupId>co.ecg</groupId>
            <artifactId>alpaca-model</artifactId>
            <version>${alpaca.version}</version>
        </dependency>
        <dependency>
            <groupId>co.ecg</groupId>
            <artifactId>alpaca-commons</artifactId>
            <version>${alpaca.version}</version>
        </dependency>
        <!--
            ECG licensing runtime: verifies the Alpaca toolkit license. Required on the classpath
            for live BroadWorks connectivity. The license itself can be supplied at runtime as a
            string via ALPACA_LICENSE_KEY (see AlpacaProperties); the jar bundles its own GPG public
            key ring (pubring.gpg) so no extra keyring provisioning is needed.
        -->
        <dependency>
            <groupId>co.ecg</groupId>
            <artifactId>ecg-licensing</artifactId>
            <version>${ecg-licensing.version}</version>
        </dependency>
        <!--
            ecg-licensing runtime companions. ecg-licensing is installed from lib/ with a MINIMAL
            generated POM (no transitive dependencies), so the plain libraries it needs at runtime are
            declared here and resolved normally from Maven Central:
              - license3j decodes/verifies the PGP-signed license string (pulls in BouncyCastle);
              - java-semver parses the license version.
            (slf4j-api is already on the classpath via the Spring Boot starters.)
        -->
        <dependency>
            <groupId>com.verhas</groupId>
            <artifactId>license3j</artifactId>
            <version>1.0.7</version>
        </dependency>
        <dependency>
            <groupId>com.github.zafarkhaja</groupId>
            <artifactId>java-semver</artifactId>
            <version>0.9.0</version>
        </dependency>

        <!--
            Alpaca toolkit runtime companion: the response cache. The toolkit's BroadWorksServer login
            machinery is wired against the classic Apache JCS API (org.apache.jcs.JCS), which only ships
            in JCS 1.x, so this is the artifact that carries that package. Required on the classpath for
            live BroadWorks connectivity (see LiveAlpacaConfig / LiveAlpacaConnectionFactory).

            The classic 1.3 POM declares a large tree of legacy, optional back-ends (JDBC/BerkeleyDB
            disk caches, the XML-RPC remote cache, the servlet admin console, etc.) built against the
            Spring Boot 2.7 / javax era we deliberately keep off this Boot 4 / jakarta classpath, so ALL
            of its transitive dependencies are excluded. The only runtime companion the in-memory cache
            path actually needs is Doug Lea's `concurrent` (used by JCS's AbstractMemoryCache); the
            commons-logging API it also uses is already supplied by jcl-over-slf4j above.
        -->
        <dependency>
            <groupId>org.apache.jcs</groupId>
            <artifactId>jcs</artifactId>
            <version>1.3</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>concurrent</groupId>
            <artifactId>concurrent</artifactId>
            <version>1.0</version>
        </dependency>

        <!--
            Further Alpaca toolkit runtime companion (the toolkit JARs are installed from lib/ with
            MINIMAL generated POMs, so the plain libraries the connection/login path needs are declared
            explicitly here). commons-lang3 is pervasive throughout the toolkit (e.g. RequestBundler /
            BroadWorksServer use org.apache.commons.lang3.mutable.*); its version is managed by the
            Spring Boot parent. (The legacy javax.validation API the toolkit's request objects also need
            is declared once, at compile scope, further down.)
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!--
            Alpaca toolkit runtime companion: Google Guava. The toolkit's BroadWorksServer keeps a
            Guava collection field (com.google.common.collect.HashBiMap, used for its time-zone cache),
            so Guava must be on the classpath. It is required not only when that cache is populated but
            as soon as Spring instantiates the prototype BroadWorksServer bean: after a successful
            construction (valid license) Spring's merged-bean-definition post-processors introspect the
            class via reflection (getDeclaredFields), which eagerly loads every field type — including
            HashBiMap. Without Guava that fails with NoClassDefFoundError, surfacing as
            "Error creating bean with name 'co.ecg.alpaca.toolkit.model.BroadWorksServer':
            Post-processing of merged bean definition failed". (The toolkit JARs ship MINIMAL generated
            POMs with no transitive dependencies, so this plain library must be declared explicitly.)
        -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.4.8-jre</version>
        </dependency>

        <!--
            Alpaca toolkit runtime companion: a Bean Validation (JSR-380) provider for the LEGACY
            javax.validation namespace. The toolkit's Request.validate() calls
            javax.validation.Validation.buildDefaultValidatorFactory(), which performs an SPI lookup
            for a provider registered under META-INF/services/javax.validation.spi.ValidationProvider.
            Only the javax.validation API (2.0.1) is otherwise on the classpath, so at runtime the login
            path fails with "Unable to create a Configuration, because no Bean Validation provider could
            be found. Add a provider like Hibernate Validator (RI) to your classpath."

            spring-boot-starter-validation brings Hibernate Validator 9.x, but that is the JAKARTA
            namespace (jakarta.validation) provider and is invisible to the toolkit's javax lookup, so a
            javax-namespace provider is needed as well. It must NOT be Hibernate Validator 6.2: that is
            the same Maven artifact (org.hibernate.validator:hibernate-validator) as the jakarta version
            the starter pulls in transitively, so Maven's nearest-wins mediation keeps the directly
            declared 6.2 and drops the jakarta one entirely — leaving Spring itself without a jakarta
            provider ("Failed to set up a Bean Validation provider:
            jakarta.validation.NoProviderFoundException" from OptionalValidatorFactoryBean, and no
            @Valid/@NotEmpty enforcement on our own beans).

            Apache BVal 2.0.x is a different artifact that implements the same javax.validation 2.0 SPI,
            so it satisfies the toolkit's javax lookup while Hibernate Validator 9 stays on the classpath
            for the jakarta namespace. The two providers live in different namespaces and coexist without
            clashing. BVal also needs an EL 3.0 implementation for constraint-message interpolation; the
            classpath only has the jakarta EL (tomcat-embed-el), so the javax EL implementation
            (glassfish javax.el) is added below. BVal's own copy of the javax API is excluded to avoid
            duplicating the validation-api 2.0.1 already declared above.
        -->
        <dependency>
            <groupId>org.apache.bval</groupId>
            <artifactId>bval-jsr</artifactId>
            <version>2.0.6</version>
            <exclusions>
                <exclusion>
                    <groupId>javax.validation</groupId>
                    <artifactId>validation-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>javax.el</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!--
            Jakarta Bean Validation API (jakarta.validation namespace) for the application's own code
            (e.g. DynamicClientRegistrationController's @NotEmpty). It also reaches the classpath
            transitively via spring-boot-starter-validation's Hibernate Validator, but it is declared
            explicitly here so that the code we compile against never depends on the legacy javax
            provider's mediation outcome (see the note above). Version is managed by the Spring Boot 4
            parent.
        -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- ===== Lombok (boilerplate reduction) ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== Test ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Boot 4 modularized MockMvc test support out of spring-boot-starter-test.
            @AutoConfigureMockMvc / MockMvc auto-configuration now live in this module.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            The Alpaca toolkit's request classes reference the legacy javax.validation API in their
            method signatures / annotations. This is needed:
              - at RUNTIME for live connectivity, so those classes (e.g. RequestBundle, wired by
                LiveAlpacaConfig) load and the login path works; and
              - on the TEST classpath, so Mockito/Byte Buddy can resolve the types to mock the (final)
                generated classes.
            Hence compile scope. Jakarta (jakarta.validation) is a different namespace and does NOT
            satisfy these references; the two APIs coexist without clashing.
        -->
        <dependency>
            <groupId>javax.validation</groupId>
            <artifactId>validation-api</artifactId>
            <version>2.0.1.Final</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Explicitly declare the annotation processors on the compiler's
                processor path. Since JDK 23+ (and enforced on JDK 26) javac no
                longer runs annotation processors discovered only on the class path
                by default, so Lombok would otherwise be skipped and the build would
                fail with "cannot find symbol log" / missing generated constructors.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${project.parent.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
                Mockito's inline mock maker rewrites bytecode via Byte Buddy to
                mock the (final) Alpaca generated classes. When the test JVM is a
                JDK newer than the bundled Byte Buddy officially supports (e.g.
                JDK 26), Byte Buddy refuses to instrument classes and the mocks
                fail with "Mockito cannot mock this class ... Could not modify all
                classes". Enabling Byte Buddy's experimental mode makes it treat
                such newer JDKs as the latest known version, restoring mocking.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <net.bytebuddy.experimental>true</net.bytebuddy.experimental>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Convenience profile that installs the Alpaca toolkit JARs from lib/
            into the local Maven repository during the `initialize` phase.
            Equivalent to running scripts/install-alpaca.sh once.

            IMPORTANT: run this as its OWN invocation that stops at `initialize`,
            BEFORE building. Combining it with a resolving phase in a single
            invocation (e.g. `mvn -Pinstall-alpaca clean package`) fails on a
            clean local repo, because Maven resolves the co.ecg:* compile
            dependencies before this profile's install-file executions run.

            Usage:
              mvn -Pinstall-alpaca initialize   # populate the local repo, then
              mvn -DskipTests clean package      # build against it
        -->
        <profile>
            <id>install-alpaca</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-install-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>install-alpaca-commons</id>
                                <phase>initialize</phase>
                                <goals><goal>install-file</goal></goals>
                                <configuration>
                                    <file>${project.basedir}/lib/alpaca-commons-12.2.0-RELEASE.jar</file>
                                    <groupId>co.ecg</groupId>
                                    <artifactId>alpaca-commons</artifactId>
                                    <version>${alpaca.version}</version>
                                    <packaging>jar</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-alpaca-model</id>
                                <phase>initialize</phase>
                                <goals><goal>install-file</goal></goals>
                                <configuration>
                                    <file>${project.basedir}/lib/alpaca-model-12.2.0-RELEASE.jar</file>
                                    <groupId>co.ecg</groupId>
                                    <artifactId>alpaca-model</artifactId>
                                    <version>${alpaca.version}</version>
                                    <packaging>jar</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-alpaca-core</id>
                                <phase>initialize</phase>
                                <goals><goal>install-file</goal></goals>
                                <configuration>
                                    <file>${project.basedir}/lib/alpaca-core-12.2.0-RELEASE-26.jar</file>
                                    <groupId>co.ecg</groupId>
                                    <artifactId>alpaca-core</artifactId>
                                    <version>${alpaca.version}</version>
                                    <packaging>jar</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-alpaca-library</id>
                                <phase>initialize</phase>
                                <goals><goal>install-file</goal></goals>
                                <configuration>
                                    <file>${project.basedir}/lib/alpaca-library-12.2.0-RELEASE-26.jar</file>
                                    <groupId>co.ecg</groupId>
                                    <artifactId>alpaca-library</artifactId>
                                    <version>${alpaca.version}</version>
                                    <packaging>jar</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-ecg-licensing</id>
                                <phase>initialize</phase>
                                <goals><goal>install-file</goal></goals>
                                <configuration>
                                    <file>${project.basedir}/lib/ecg-licensing-6.2.0-RELEASE.jar</file>
                                    <groupId>co.ecg</groupId>
                                    <artifactId>ecg-licensing</artifactId>
                                    <version>${ecg-licensing.version}</version>
                                    <packaging>jar</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
