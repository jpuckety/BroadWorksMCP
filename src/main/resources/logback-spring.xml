<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration.

  Under the `stdio` profile stdout is reserved for the MCP protocol, so all logs
  are written to STDERR. In every other profile (HTTP) the standard Spring Boot
  console appender (stdout) is used.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="stdio">
        <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.err</target>
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
                <charset>${CONSOLE_LOG_CHARSET:-UTF-8}</charset>
            </encoder>
        </appender>
        <root level="DEBUG">
            <appender-ref ref="STDERR"/>
        </root>
    </springProfile>

    <springProfile name="!stdio">
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

        <logger name="com.broadworks.mcp" level="DEBUG"/>
        <logger name="software.amazon.awssdk.auth.credentials" level="INFO" />

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
