<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration.

  Under the `stdio` profile stdout is reserved for the MCP protocol, so all logs
  are written to STDERR. In every other profile (HTTP) the standard Spring Boot
  console appender (stdout) is used.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="stdio">
        <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.err</target>
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
                <charset>${CONSOLE_LOG_CHARSET:-UTF-8}</charset>
            </encoder>
        </appender>
        <root level="DEBUG">
            <appender-ref ref="STDERR"/>
        </root>
    </springProfile>

    <springProfile name="!stdio">
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

        <!--
          Log levels are overridable at runtime via environment variables (or -D system properties)
          so operators can raise verbosity for troubleshooting without a rebuild/redeploy, e.g.
          LOG_LEVEL_MCP_ENDPOINTS=DEBUG for the MCP access log, or LOG_LEVEL_MCP=DEBUG / TRACE for the
          Spring AI + MCP SDK protocol internals. See README "Logging & troubleshooting".
        -->
        <logger name="com.broadworks.mcp" level="${LOG_LEVEL_APP:-DEBUG}"/>
        <logger name="com.broadworks.mcp.web" level="${LOG_LEVEL_MCP_ENDPOINTS:-DEBUG}"/>
        <logger name="org.springframework.ai.mcp" level="${LOG_LEVEL_MCP:-INFO}"/>
        <logger name="io.modelcontextprotocol" level="${LOG_LEVEL_MCP:-INFO}"/>
        <logger name="org.springframework.security" level="${LOG_LEVEL_SECURITY:-INFO}"/>
        <logger name="software.amazon.awssdk.auth.credentials" level="INFO" />
        <logger name="co.ecg.alpaca" level="${LOG_LEVEL_ALPACA:-DEBUG}"/>

        <root level="${LOG_LEVEL_ROOT:-INFO}">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
